NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
DATA_FILE=./data/xeniosai.json
SESSION_SECRET=replace-with-a-long-random-secret
INTEGRATION_SECRET_KEY=replace-with-a-separate-long-random-secret
GOOGLE_CLIENT_ID=

# Integration/provider API versions should be configuration, not scattered in adapters.
META_GRAPH_VERSION=v26.0

# AI providers. Model names are configuration, not hard-coded product assumptions.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# User subscription billing. Defaults to mock when no live provider is configured.
BILLING_PROVIDER=mock
BILLING_CURRENCY=php
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
