NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATA_FILE=./data/xeniosai.json
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=

# AI providers. Model names are configuration, not hard-coded product assumptions.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# User subscription billing. Defaults to mock when no live provider is configured.
BILLING_PROVIDER=mock
BILLING_CURRENCY=php
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
