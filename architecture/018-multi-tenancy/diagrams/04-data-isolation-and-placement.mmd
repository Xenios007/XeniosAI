flowchart TB
    REQUIREMENTS["Tenant Requirements<br/>Risk, residency, scale, service, recovery"]
    PROFILE["Approved Isolation Profile"]
    DECISION{"Placement Model"}

    SHARED["Shared Logical<br/>Shared runtime and stores<br/>Tenant keys and policy"]
    PARTITIONED["Partitioned<br/>Dedicated schema, shard,<br/>queue, index, or pool"]
    DEDICATED["Dedicated<br/>Tenant-specific store, cell,<br/>account, or environment"]

    INVARIANTS["Common Invariants<br/>Explicit context, provider validation,<br/>encryption, quotas, telemetry, recovery"]
    PLACEMENT["Trusted Placement and Routing"]
    OPERATIONS["Lifecycle, Operations, and Assurance"]
    MIGRATION["Governed Migration and Reconciliation"]

    REQUIREMENTS --> PROFILE
    PROFILE --> DECISION
    DECISION -->|standard risk and efficient scale| SHARED
    DECISION -->|containment or predictable scale| PARTITIONED
    DECISION -->|contract, sovereignty, or exceptional risk| DEDICATED

    SHARED --> INVARIANTS
    PARTITIONED --> INVARIANTS
    DEDICATED --> INVARIANTS
    INVARIANTS --> PLACEMENT
    PLACEMENT --> OPERATIONS
    OPERATIONS --> MIGRATION
    MIGRATION -. "profile or placement change" .-> PROFILE

